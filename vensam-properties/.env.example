# ── Firebase (Auth + Firestore) ─────────────────────────────────────────────
# From Firebase console → Project settings → Your apps → SDK setup (npm) →
# Config. Paste the six values below (locally in .env, and later as the same
# env vars in Vercel → Project Settings → Environment Variables).
# With these unset the site runs on the bundled presentation copy and all
# account/admin features stay disabled — nothing is stored in the browser.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Server-only (SSR reads + seed script) ───────────────────────────────────
# Service-account JSON from Firebase console → Project settings → Service
# accounts → Generate new private key. Paste the ENTIRE file contents as one
# line (keep the quotes), or base64-encode it. Used by Next.js server-side
# reads and `npm run seed`. Set the same value in Vercel later.
FIREBASE_SERVICE_ACCOUNT=

# Server-side project id for the seed script and Admin SDK (same value as
# NEXT_PUBLIC_FIREBASE_PROJECT_ID).
FIREBASE_PROJECT_ID=

# ── On-demand revalidation ───────────────────────────────────────────────────
# Shared secret for POST /api/revalidate (sent as header x-revalidate-secret).
# Same value for both vars.
REVALIDATE_SECRET=
NEXT_PUBLIC_REVALIDATE_SECRET=

# Optional: used by `npm run seed` to create the first admin (Firebase Auth
# user + admins/ doc that unlocks writes in firestore.rules).
ADMIN_EMAIL=
ADMIN_PASSWORD=
